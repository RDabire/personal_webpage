---
import { profile, workHistory } from '@/data/profile';
import { siteFeatures } from '@/config/site';
import type { LanguageCode } from '@/i18n/ui';
interface Props {
  lang: LanguageCode;
  writingPreviews: Array<{
    slug: string;
    title: string;
    description?: string;
    pubDate: Date;
  }>;
}
const { writingPreviews } = Astro.props;
---

<section class="plain-intro">
  <p class="plain-label">HOME / 001</p>
  <h1>{profile.name}</h1>
  <p>{profile.introduction}</p>
  <p>{profile.approach}</p>
  <p>{profile.work}</p>
  <p>{profile.personal}</p>
</section>
{
  siteFeatures.blog && (
    <section class="plain-section">
      <h2>Writing</h2>
      {writingPreviews.length ? (
        writingPreviews.map((post) => (
          <div class="plain-post">
            <>
              <time datetime={post.pubDate.toISOString()}>
                {post.pubDate.toISOString().slice(0, 10)}
              </time>
              <a href={'/blog/' + post.slug}>{post.title}</a>
              <span>{post.description}</span>
            </>
          </div>
        ))
      ) : (
        <p class="plain-small">Nothing published yet.</p>
      )}
      <p class="plain-small">
        <a href="/blog">Browse the archive →</a>
      </p>
    </section>
  )
}
<section class="plain-section">
  <h2>Work history</h2>
  <dl class="plain-history">
    {
      workHistory.slice(0, 4).map((entry) => (
        <div>
          <>
            <dt>{entry.period}</dt>
            <dd>
              {entry.role}
              <span>{entry.company}</span>
            </dd>
          </>
        </div>
      ))
    }
  </dl>
  <p class="plain-small"><a href="/resume">More context →</a></p>
</section>
<section class="plain-section">
  <h2>Elsewhere</h2>
  <div class="plain-links">
    <a href="https://www.linkedin.com/in/roy-dabire">LinkedIn ↗</a><a
      href="/contact">Book a call ↗</a
    >
  </div>
</section>
