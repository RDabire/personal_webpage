---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';
import type { LanguageCode } from '@/i18n/ui';
interface Props {
  post: CollectionEntry<'blog'>['data'];
  lang: LanguageCode;
  relatedPosts: Array<CollectionEntry<'blog'>>;
}
const { post, lang, relatedPosts } = Astro.props;
const slug = (id: string) =>
  id.includes('/') ? id.split('/').slice(1).join('/') : id;
---

<BaseLayout
  pageTitle={post.title + ' | Roy Dabire'}
  pageDescription={post.description}
>
  <article>
    <header class="plain-intro">
      <p class="plain-small"><a href="/blog">← All writing</a></p>
      <h1>{post.title}</h1>
      <div class="post-meta">
        <time datetime={post.pubDate.toISOString()}
          >{formatDate(post.pubDate, lang)}</time
        >{
          post.readingTimeMinutes && (
            <span>{post.readingTimeMinutes} min read</span>
          )
        }{
          post.updatedDate && (
            <span>Updated {formatDate(post.updatedDate, lang)}</span>
          )
        }
      </div>
      {
        post.tags?.length ? (
          <p class="plain-small">
            {post.tags.map((tag) => (
              <a
                href={'/blog?tag=' + encodeURIComponent(tag)}
                style="margin-right: 15px"
              >
                #{tag}
              </a>
            ))}
          </p>
        ) : null
      }
    </header>
    <div class="plain-prose"><slot /></div>
    {
      relatedPosts.length > 0 && (
        <section class="plain-section">
          <h2>More writing</h2>
          {relatedPosts.map((entry) => (
            <p>
              <a href={'/blog/' + slug(entry.id)}>{entry.data.title}</a>
            </p>
          ))}
        </section>
      )
    }
  </article>
</BaseLayout>
