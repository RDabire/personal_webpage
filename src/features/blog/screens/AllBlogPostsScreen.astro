---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import type { LanguageCode } from '@/i18n/ui';
interface Props {
  posts: Array<CollectionEntry<'blog'>>;
  lang: LanguageCode;
}
const { posts } = Astro.props;
const query = Astro.url.searchParams.get('q')?.trim() || '';
const tag = Astro.url.searchParams.get('tag') || '';
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
const visiblePosts = posts.filter((post) => {
  const searchable = [
    post.data.title,
    post.data.description || '',
    post.body || '',
  ]
    .join(' ')
    .toLowerCase();
  return (
    (!query || searchable.includes(query.toLowerCase())) &&
    (!tag || post.data.tags?.includes(tag))
  );
});
const slug = (id: string) =>
  id.includes('/') ? id.split('/').slice(1).join('/') : id;
---

<BaseLayout
  pageTitle="Writing | Roy Dabire"
  pageDescription="Notes on data, analytics, machine learning, and things I’m learning."
>
  <section class="plain-intro">
    <p class="plain-label">WRITING / 003</p>
    <h1>Notes & writing.</h1>
    <p>
      Things I’ve learned at work, things I’m trying, and the occasional detour.
    </p>
  </section>
  <section class="plain-section">
    <form class="archive-search" action="/blog" method="get" role="search">
      <label for="post-search"
        >Search posts<input
          id="post-search"
          name="q"
          type="search"
          value={query}
          placeholder="A word or topic"
        /></label
      >
      {
        tags.length > 0 && (
          <label for="post-tag">
            Tag
            <select id="post-tag" name="tag">
              <option value="">All tags</option>
              {tags.map((item) => (
                <option value={item} selected={tag === item}>
                  {item}
                </option>
              ))}
            </select>
          </label>
        )
      }
      <button type="submit">Search →</button>
      {(query || tag) && <a href="/blog">Clear</a>}
    </form>
    <div id="blog-posts-container">
      {
        visiblePosts.map((post) => (
          <div class="blog-post-card-wrapper">
            <div class="plain-post">
              <>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <a href={'/blog/' + slug(post.id)}>{post.data.title}</a>
                <span>{post.data.description}</span>
              </>
            </div>
          </div>
        ))
      }
      {
        !visiblePosts.length && (
          <p role="status" class="plain-small">
            No posts found.
            {query || tag ? ' Try another search, or clear the filters.' : ''}
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
<style>
  .archive-search {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    align-items: end;
    padding-bottom: 25px;
    font-size: 11px;
  }
  label {
    flex: 1;
    min-width: 150px;
  }
  input,
  select {
    display: block;
    width: 100%;
    margin-top: 7px;
    padding: 9px 11px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    border-radius: 0;
    font: inherit;
  }
  button {
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--link);
    padding: 9px 15px;
    font: inherit;
    cursor: pointer;
  }
  button:hover {
    border-color: var(--link);
  }
  .archive-search > a {
    padding-bottom: 9px;
  }
</style>
