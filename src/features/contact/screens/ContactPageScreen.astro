---
interface Props {
  mainHeadingTitle: string;
  mainHeadingDescription: string;
  calendarTitle: string;
  calendarDescription: string;
  calendarBookingUrl: string;
}
const {
  mainHeadingTitle,
  mainHeadingDescription,
  calendarTitle,
  calendarDescription,
  calendarBookingUrl,
} = Astro.props;
---

<section class="plain-intro">
  <p class="plain-label">CONTACT / 003</p>
  <h1>{mainHeadingTitle}</h1>
  <p>{mainHeadingDescription}</p>
  <p>
    <a href="https://www.linkedin.com/in/roy-dabire"
      >Send me a message on LinkedIn ↗</a>
  </p>
</section>
<section class="plain-section">
  <h2>{calendarTitle}</h2>
  <p>{calendarDescription}</p>
  <p>
    <a href={calendarBookingUrl} target="_blank" rel="noopener noreferrer"
      >Choose a time on Google Calendar ↗</a>
  </p>
</section>
