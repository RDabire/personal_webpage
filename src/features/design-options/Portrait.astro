---
import { siteFeatures } from '@/config/site';
---

<div class="portrait-page">
  <header>
    <a class="brand" href="/designs/portrait"
      >Roy Dabire<span>A personal website</span></a
    ><nav aria-label="Site navigation">
      {siteFeatures.blog && <a href="/blog">Writing</a>}<a href="/resume"
        >About me</a
      ><a href="/contact">Get in touch ↗</a>
    </nav>
  </header>
  <main id="main">
    <section class="hero">
      <div class="intro">
        <p class="eyebrow">Fraud and scam analytics. Australia.</p><h1>
          Hi, I’m Roy.<br /><em>Nice to<br />meet you.</em>
        </h1><p>
          I work in fraud and scam analytics at CBA. I’m here to share a few
          things I’ve learned, and to meet people doing interesting work.
        </p><a class="read" href={siteFeatures.blog ? '/blog' : '/resume'}
          >{siteFeatures.blog ? 'Read my writing' : 'More about me'}
          <span>↗</span></a
        >
      </div><figure>
        <img
          src="/profile.jpg"
          alt="Portrait of Roy Dabire"
          width="900"
          height="1100"
        /><figcaption>
          <span>Roy Dabire</span><span>Off the clock.</span>
        </figcaption>
      </figure>
    </section>
    <section class="about">
      <h2>A bit about me.</h2><div>
        <p>
          I recently moved from mining to banking. I’m now a Senior Analyst in
          Advanced Analytics (Fraud) at CBA, working on fraud and scam detection
          to help protect customers. Before this, I worked at Fortescue,
          Newmont, and Newcrest.
        </p><p>
          Outside work, I like long runs and strategy games. I also like
          building small tools that make everyday life easier.
        </p><a href="/resume">More about my work →</a>
      </div>
    </section>
    {
      siteFeatures.blog && (
        <section class="writing">
          <>
            <div>
              <>
                <p class="eyebrow">From the blog</p>
                <h2>Something to read.</h2>
              </>
            </div>
            <a class="article" href="/blog/welcome-post">
              <>
                <time datetime="2026-02-01">February 2026</time>
                <h3>Welcome</h3>
                <p>
                  What you can expect from this little corner of the internet.
                </p>
                <span>Read the post ↗</span>
              </>
            </a>
          </>
        </section>
      )
    }
    <footer>
      <p>
        Have something in mind?<br /><a href="/contact"
          >Let’s have a conversation.</a
        >
      </p><a href="https://www.linkedin.com/in/roy-dabire">LinkedIn ↗</a>
    </footer>
  </main>
</div>
<style>
  .portrait-page {
    background: #f7eee7;
    color: #302821;
    font-family: 'DM Sans', Arial, sans-serif;
    min-height: calc(100vh - 56px);
  }
  a {
    color: inherit;
  }
  header,
  main {
    max-width: 1300px;
    margin: auto;
    padding-left: 6vw;
    padding-right: 6vw;
  }
  header {
    padding-top: 32px;
    padding-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .brand {
    text-decoration: none;
    font:
      30px 'Instrument Serif',
      Georgia,
      serif;
  }
  .brand span {
    display: block;
    font:
      10px 'DM Sans',
      sans-serif;
    margin-top: 4px;
    color: #846e5c;
  }
  nav {
    display: flex;
    gap: 30px;
    font-size: 12px;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 65px;
    padding: 45px 0 65px;
    align-items: center;
  }
  .eyebrow {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.7px;
    color: #876a55;
  }
  h1 {
    font:
      400 clamp(65px, 7.5vw, 100px) / 0.98 'Instrument Serif',
      Georgia,
      serif;
    margin: 30px 0;
    letter-spacing: -2px;
  }
  h1 em {
    color: #986144;
  }
  .intro > p:not(.eyebrow) {
    max-width: 375px;
    font-size: 16px;
    line-height: 1.8;
    color: #6b594a;
  }
  .read {
    display: flex;
    justify-content: space-between;
    width: 205px;
    padding: 15px 0 8px;
    border-bottom: 1px solid;
    text-decoration: none;
    font-size: 13px;
    margin-top: 25px;
  }
  figure {
    margin: 0;
    padding: 12px 12px 0;
    background: #e5b497;
    transform: rotate(2deg);
  }
  figure img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center 30%;
  }
  figcaption {
    padding: 15px 3px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
  }
  .about {
    border-top: 1px solid #d6bba7;
    padding: 45px 0;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 65px;
  }
  h2 {
    font:
      400 44px 'Instrument Serif',
      Georgia,
      serif;
    margin: 0;
  }
  .about p {
    font-size: 15px;
    line-height: 1.8;
    color: #6b594a;
    margin: 0 0 20px;
  }
  .about a {
    font-size: 12px;
  }
  .writing {
    border-top: 1px solid #d6bba7;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 65px;
    padding: 40px 0 55px;
  }
  .writing .eyebrow {
    margin: 0 0 14px;
  }
  .article {
    text-decoration: none;
    padding: 25px 30px;
    background: #ede0d5;
  }
  time {
    font-size: 10px;
    color: #876a55;
  }
  h3 {
    font:
      400 40px 'Instrument Serif',
      Georgia,
      serif;
    margin: 20px 0 10px;
  }
  .article p {
    color: #6b594a;
    font-size: 14px;
    line-height: 1.7;
    max-width: 280px;
  }
  .article > span {
    display: block;
    margin-top: 25px;
    font-size: 12px;
    text-decoration: underline;
  }
  .article:hover {
    background: #e7d5c7;
  }
  footer {
    padding: 35px 0 40px;
    border-top: 1px solid #d6bba7;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
  }
  footer p {
    font:
      28px/1.5 'Instrument Serif',
      Georgia,
      serif;
    margin: 0;
  }
  footer > a {
    font-size: 12px;
  }
  @media (max-width: 700px) {
    header {
      flex-wrap: wrap;
      gap: 25px;
    }
    nav {
      gap: 23px;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 15px;
    }
    figure {
      max-width: 420px;
    }
    figure img {
      height: 390px;
    }
    .about,
    .writing {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    footer {
      flex-wrap: wrap;
    }
  }
</style>
