---
import { siteFeatures } from '@/config/site';
---

<div class="field">
  <div class="paper">
    <header>
      <a href="/designs/field-notes">RD / Field notes</a><nav
        aria-label="Site navigation"
      >
        {siteFeatures.blog && <a href="/blog">Writing</a>}<a href="/resume"
          >About</a
        ><a href="/contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <section class="intro">
        <div class="margin-note">
          01 — Introduction<br /><span>Australia</span>
        </div><div>
          <p class="eyebrow">A notebook by Roy Dabire</p><h1>
            Data & detection,<br /><em>from the field.</em>
          </h1><p class="lead">
            I’m Roy. I work in fraud and scam analytics at CBA, and like
            building useful things.
          </p>
        </div><figure>
          <img
            src="/profile.jpg"
            alt="Roy Dabire"
            width="180"
            height="210"
          /><figcaption>Roy, away from the notebook.</figcaption>
        </figure>
      </section>
      <section class="entry">
        <div class="margin-note">02 — These days</div><div>
          <h2>At work, and after work.</h2><p>
            I’m a Senior Analyst in Advanced Analytics (Fraud) at CBA. I
            investigate fraud and scam patterns with SQL and turn analysis into
            detection rules to help protect customers.
          </p><p>
            Before banking, I worked at Fortescue, Newmont, and Newcrest.
            Outside work: long runs, strategy games, and building things.
          </p><a href="/resume">More about my work →</a>
        </div>
      </section>
      {
        siteFeatures.blog && (
          <section class="entry">
            <>
              <div class="margin-note">03 — On paper</div>
              <div>
                <>
                  <div class="writing-head">
                    <h2>Notes & writing</h2>
                    {siteFeatures.blog && <a href="/blog">The archive →</a>}
                  </div>
                  <a class="post" href="/blog/welcome-post">
                    <>
                      <time datetime="2026-02-01">01 FEB 2026</time>
                      <span>Welcome</span>
                      <p>What you can expect from this space.</p>
                      <span class="post-arrow">↗</span>
                    </>
                  </a>
                </>
              </div>
            </>
          </section>
        )
      }
      <footer>
        <span>There’s a person behind these notes.</span><a
          href="https://www.linkedin.com/in/roy-dabire"
          >Say hello on LinkedIn ↗</a
        >
      </footer>
    </main>
  </div>
</div>
<style>
  .field {
    background: #dfe5d5;
    color: #303c29;
    min-height: calc(100vh - 56px);
    padding: 35px 5vw 55px;
    font:
      17px/1.7 Georgia,
      serif;
  }
  .paper {
    max-width: 1160px;
    margin: auto;
    background: #f9f8f0;
    padding: 0 48px;
    border: 1px solid #bdc5b2;
    box-shadow: 7px 7px 0 #cbd3bf;
  }
  a {
    color: inherit;
  }
  header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid #c6cdbd;
    padding: 28px 0;
    font:
      11px 'IBM Plex Mono',
      monospace;
  }
  header a {
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 25px;
  }
  main {
    padding-top: 50px;
  }
  .intro {
    display: grid;
    grid-template-columns: 135px 1fr 180px;
    gap: 25px;
    align-items: start;
    padding-bottom: 50px;
  }
  .margin-note {
    font:
      10px/1.8 'IBM Plex Mono',
      monospace;
    color: #6b785d;
    padding-top: 6px;
  }
  .margin-note span {
    display: block;
    margin-top: 24px;
  }
  .eyebrow {
    font:
      10px 'IBM Plex Mono',
      monospace;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 24px;
  }
  h1 {
    font:
      400 clamp(44px, 5.5vw, 70px) / 1.06 'Instrument Serif',
      Georgia,
      serif;
    letter-spacing: -1px;
    margin: 0 0 28px;
  }
  h1 em {
    color: #60744b;
  }
  .lead {
    margin: 0;
    font-size: 20px;
    line-height: 1.6;
  }
  figure {
    margin: 25px 0 0;
    transform: rotate(3deg);
    background: #fff;
    border: 1px solid #d7dacd;
    padding: 8px 8px 12px;
  }
  figure img {
    object-fit: cover;
    object-position: center 30%;
    height: 210px;
    width: 100%;
    filter: saturate(0.75);
  }
  figcaption {
    font:
      9px/1.5 'IBM Plex Mono',
      monospace;
    margin-top: 9px;
  }
  .entry {
    display: grid;
    grid-template-columns: 135px 1fr;
    gap: 25px;
    border-top: 1px solid #c6cdbd;
    padding: 35px 0 42px;
  }
  .entry > div:last-child {
    max-width: 650px;
  }
  h2 {
    font:
      400 34px 'Instrument Serif',
      serif;
    margin: 0 0 20px;
  }
  .entry p {
    margin: 0 0 22px;
  }
  .entry a:not(.post) {
    font:
      11px 'IBM Plex Mono',
      monospace;
  }
  .writing-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: baseline;
  }
  .post {
    display: block;
    position: relative;
    text-decoration: none;
    padding: 20px 40px 20px 0;
    border-top: 1px dashed #c6cdbd;
    border-bottom: 1px dashed #c6cdbd;
  }
  time {
    display: block;
    font:
      10px 'IBM Plex Mono',
      monospace;
    color: #6b785d;
    margin-bottom: 12px;
  }
  .post > span {
    font-size: 25px;
  }
  .post p {
    font-size: 15px;
    margin: 7px 0 0;
    color: #6b785d;
  }
  .post .post-arrow {
    position: absolute;
    right: 0;
    top: 48px;
  }
  .post:hover > span {
    text-decoration: underline;
  }
  footer {
    border-top: 1px solid #c6cdbd;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 25px 0;
    font:
      10px/1.6 'IBM Plex Mono',
      monospace;
  }
  @media (max-width: 960px) {
    .intro {
      grid-template-columns: 100px 1fr;
    }
    figure {
      grid-column: 2;
      width: 150px;
      margin-top: 0;
    }
    .entry {
      grid-template-columns: 100px 1fr;
    }
  }
  @media (max-width: 600px) {
    .field {
      padding: 18px 14px 30px;
    }
    .paper {
      padding: 0 22px;
    }
    header {
      flex-wrap: wrap;
      gap: 18px;
    }
    nav {
      gap: 22px;
    }
    main {
      padding-top: 28px;
    }
    .intro,
    .entry {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    figure {
      grid-column: 1;
      width: 145px;
    }
    .margin-note span {
      display: inline;
      margin-left: 10px;
    }
    .writing-head {
      flex-wrap: wrap;
      gap: 0;
      margin-bottom: 20px;
    }
  }
</style>
