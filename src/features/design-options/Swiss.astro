---
import { siteFeatures } from '@/config/site';
---

<div class="swiss">
  <header>
    <a class="brand" href="/designs/swiss">RD</a><span class="location"
      >Fraud and scam analytics<br />Australia</span
    ><nav aria-label="Site navigation">
      {siteFeatures.blog && <a href="/blog">Writing ↗</a>}<a href="/resume"
        >About ↗</a
      ><a href="/contact">Contact ↗</a>
    </nav>
  </header>
  <main id="main">
    <section class="hero">
      <p class="label">Roy Dabire / Personal website</p><h1>
        I work on<br /><span>fraud and scam detection.</span>
      </h1><div class="hero-bottom">
        <p>SQL. Detection rules. Helping protect customers.</p><a
          href="/resume"
          aria-label="Read about my work">↘</a
        >
      </div>
    </section>
    <section class="work">
      <h2>01 / Work</h2><div>
        <p class="big-copy">
          Currently at CBA.<br />Previously Fortescue,<br />Newmont and
          Newcrest.
        </p><p class="body-copy">
          My work has taken me from mining to banking. These days I use SQL to
          investigate fraud and scam patterns at CBA.
        </p><a class="text-link" href="/resume">The longer version ↗</a>
      </div>
    </section>
    {
      siteFeatures.blog && (
        <section class="writing">
          <>
            <h2>02 / Writing</h2>
            <a href="/blog/welcome-post">
              <>
                <time datetime="2026-02-01">01.02.2026</time>
                <span>Welcome</span>
                <span class="arrow">↗</span>
              </>
            </a>
          </>
        </section>
      )
    }
    <footer>
      <p>Long runs.<br />Strategy games.<br />A few notes on data.</p><a
        href="https://www.linkedin.com/in/roy-dabire">Let’s talk ↗</a
      ><span>Roy Dabire</span>
    </footer>
  </main>
</div>
<style>
  .swiss {
    min-height: calc(100vh - 56px);
    background: #f7f7f2;
    color: #1c1c19;
    font-family: 'DM Sans', Arial, sans-serif;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  header,
  main {
    max-width: 1440px;
    margin: auto;
    padding: 0 6vw;
  }
  header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding-top: 28px;
    padding-bottom: 28px;
    align-items: start;
    font-size: 12px;
  }
  .brand {
    font-weight: 700;
    font-size: 35px;
    letter-spacing: -3px;
    line-height: 1;
  }
  .brand span {
    font-size: 12px;
    vertical-align: top;
    letter-spacing: 0;
    margin-left: 4px;
  }
  .location {
    line-height: 1.5;
  }
  nav {
    display: flex;
    justify-content: end;
    gap: 24px;
  }
  nav a:hover,
  .text-link:hover {
    text-decoration: underline;
  }
  .hero {
    border-top: 1px solid #222;
    padding: 30px 0 44px;
  }
  .label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 35px;
  }
  h1 {
    font-size: clamp(70px, 11vw, 156px);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.075em;
    margin: 0;
  }
  h1 span {
    color: #d73520;
  }
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-top: 40px;
  }
  .hero-bottom p {
    max-width: 310px;
    font-size: 18px;
    line-height: 1.5;
    margin: 0;
  }
  .hero-bottom a {
    font-size: 60px;
    line-height: 1;
  }
  h2 {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }
  .work {
    display: grid;
    grid-template-columns: 1fr 2fr;
    border-top: 1px solid #222;
    padding: 35px 0 50px;
  }
  .big-copy {
    font-size: clamp(29px, 4vw, 48px);
    line-height: 1.15;
    letter-spacing: -2px;
    margin: 0 0 28px;
  }
  .body-copy {
    max-width: 470px;
    font-size: 16px;
    line-height: 1.7;
    color: #55554d;
  }
  .text-link {
    font-size: 13px;
    border-bottom: 1px solid;
    padding-bottom: 3px;
  }
  .writing {
    border-top: 1px solid #222;
    padding: 30px 0;
  }
  .writing > a {
    display: grid;
    grid-template-columns: 1fr 1.8fr 0.2fr;
    align-items: baseline;
    margin-top: 40px;
  }
  time {
    font:
      11px 'IBM Plex Mono',
      monospace;
  }
  .writing > a > span {
    font-size: 40px;
    letter-spacing: -1.5px;
  }
  .writing > a:hover {
    color: #d73520;
  }
  .arrow {
    text-align: right;
  }
  footer {
    border-top: 1px solid #222;
    padding: 35px 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 25px;
    font-size: 12px;
  }
  footer p {
    margin: 0;
    line-height: 1.6;
  }
  footer > a {
    font-size: 24px;
    text-decoration: underline;
  }
  @media (max-width: 650px) {
    header {
      grid-template-columns: 1fr auto;
      gap: 22px;
    }
    .location {
      display: none;
    }
    nav {
      gap: 16px;
    }
    .work {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .writing > a {
      grid-template-columns: 1fr auto;
      row-gap: 15px;
    }
    time {
      grid-column: 1 / -1;
    }
    footer {
      flex-wrap: wrap;
    }
    h1 {
      font-size: clamp(64px, 13vw, 90px);
    }
  }
</style>
