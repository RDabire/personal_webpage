---
import '../styles/global.css';
import '../styles/plain.css';
import { profile } from '@/data/profile';
import { siteFeatures } from '@/config/site';
interface Props {
  pageTitle: string;
  pageDescription?: string;
}
const { pageTitle, pageDescription = profile.description } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  ...(siteFeatures.blog ? [{ href: '/blog', label: 'writing' }] : []),
  { href: '/resume', label: 'about' },
  { href: '/contact', label: 'contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/profile.jpg" />
    <link rel="apple-touch-icon" href="/profile.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="plain-site">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="plain-shell">
      <header class="plain-header">
        <a
          class="plain-name"
          href="/"
          aria-current={pathname === '/' ? 'page' : undefined}>roy dabire</a
        >
        <nav aria-label="Main navigation">
          {
            links.map((link, index) => (
              <>
                <>
                  <span aria-hidden="true">{index > 0 ? ' / ' : ''}</span>
                  <a
                    href={link.href}
                    aria-current={
                      pathname === link.href ||
                      pathname.startsWith(link.href + '/')
                        ? 'page'
                        : undefined
                    }
                  >
                    {link.label}
                  </a>
                </>
              </>
            ))
          }
        </nav>
      </header>
      <main id="main-content"><slot /></main>
      <footer class="plain-footer">
        <span>Roy Dabire / Australia</span><a href="#main-content"
          >Back to top ↑</a
        >
      </footer>
    </div>
  </body>
</html>
