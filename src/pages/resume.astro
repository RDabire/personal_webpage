---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { workHistory } from '@/data/profile';
---

<BaseLayout
  pageTitle="About | Roy Dabire"
  pageDescription="Roy Dabire on building useful tools, understanding the bigger picture, and working across analytics and machine learning."
>
  <section class="plain-intro">
    <p class="plain-label">ABOUT / 002</p>
    <h1>Background & approach.</h1>
    <p>
      My career began in customer-facing sales and banking before moving into
      applied data science, industrial analytics, enterprise AI, and production
      machine learning. I now work on fraud and scams at CBA.
    </p>
    <p>
      Across these roles, I’ve worked with domain specialists to understand
      operational problems and deliver systems people use in their day-to-day
      work.
    </p>
  </section>
  <section class="plain-section">
    <h2>Work history</h2>
    {
      workHistory.map((entry) => (
        <article
          class="plain-job"
          id={entry.id}
          aria-labelledby={entry.id + '-title'}
        >
          <p class="job-period">{entry.period}</p>
          <div class="job-content">
            <header>
              <h3 id={entry.id + '-title'}>{entry.role}</h3>
              <p class="company">{entry.company}</p>
              {entry.context && <p class="job-context">{entry.context}</p>}
            </header>
            <p class="job-summary">{entry.summary}</p>
            <section
              class="job-contributions"
              aria-labelledby={entry.id + '-contributions'}
            >
              <h4 id={entry.id + '-contributions'}>Work & outcomes</h4>
              <ul>
                {entry.highlights.map((highlight) => (
                  <li>
                    <strong>{highlight.title}</strong>
                    <p>{highlight.detail}</p>
                  </li>
                ))}
              </ul>
            </section>
            <div class="job-capabilities">
              <section aria-labelledby={entry.id + '-skills'}>
                <h4 id={entry.id + '-skills'}>Skills</h4>
                <ul>
                  {entry.skills.map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </section>
              <section aria-labelledby={entry.id + '-stack'}>
                <h4 id={entry.id + '-stack'}>
                  {entry.stackLabel || 'Tech stack'}
                </h4>
                <ul>
                  {entry.techStack.map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>
              </section>
            </div>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
