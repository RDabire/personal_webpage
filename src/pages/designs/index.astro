---
import { options } from '@/features/design-options/options';
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="robots" content="noindex" />
    <title>Five homepage directions — Roy Dabire</title>
  </head>
  <body>
    <header>
      <a href="/">← Current website</a><span>Roy Dabire / Design studies</span>
    </header>
    <main>
      <div class="intro">
        <p class="eyebrow">Five ways to introduce yourself</p><h1>
          A page that feels<br />like a person.
        </h1><p>
          Same person, five different approaches. Open each design, try it on
          your phone, and see which one sounds and feels like you.
        </p>
      </div>
      <div class="grid">
        {
          options.map((option, index) => (
            <article>
              <a
                class="preview-link"
                href={`/designs/${option.slug}`}
                aria-label={`Open ${option.name}`}
                style={`--paper: ${option.color}`}
              >
                <div class="preview">
                  <iframe
                    src={`/designs/${option.slug}`}
                    title={`${option.name} preview`}
                    loading="lazy"
                    tabindex="-1"
                    inert
                  />
                </div>
                <span class="open">Open design ↗</span>
              </a>
              <div class="caption">
                <>
                  <span class="number">0{index + 1}</span>
                  <div>
                    <>
                      <h2>
                        <a href={`/designs/${option.slug}`}>{option.name}</a>
                      </h2>
                      <p>{option.description}</p>
                      <small>{option.type}</small>
                    </>
                  </div>
                </>
              </div>
            </article>
          ))
        }
      </div>
      <footer>
        These are static homepage studies. Links lead to your about and contact
        pages.
      </footer>
    </main>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: #f4f3ef;
    color: #252525;
    font-family: Arial, sans-serif;
  }
  :global(a) {
    color: inherit;
    text-underline-offset: 4px;
  }
  :global(a:focus-visible) {
    outline: 3px solid #2359af;
    outline-offset: 4px;
  }
  header {
    display: flex;
    justify-content: space-between;
    padding: 26px 5vw;
    border-bottom: 1px solid #d6d5d0;
    font-size: 13px;
    gap: 20px;
  }
  main {
    max-width: 1400px;
    margin: auto;
    padding: 65px 5vw 35px;
  }
  .intro {
    margin-bottom: 65px;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 11px;
  }
  h1 {
    font:
      400 clamp(45px, 6vw, 78px) / 1.03 Georgia,
      serif;
    letter-spacing: -3px;
    margin: 22px 0;
  }
  .intro > p:last-child {
    max-width: 550px;
    line-height: 1.65;
    color: #5c5c58;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 55px 30px;
  }
  .preview-link {
    display: block;
    position: relative;
    padding: 24px;
    background: var(--paper);
    text-decoration: none;
  }
  .preview {
    height: 330px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 6px 25px #00000015;
  }
  iframe {
    width: 200%;
    height: 780px;
    border: 0;
    transform: scale(0.5);
    transform-origin: top left;
    pointer-events: none;
  }
  .open {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 8px 12px;
    font-size: 12px;
    color: white;
    background: #252525;
  }
  .preview-link:hover .open {
    background: #474742;
  }
  .caption {
    display: flex;
    gap: 20px;
    padding-top: 22px;
  }
  .number {
    font:
      14px Georgia,
      serif;
    padding-top: 5px;
    color: #777;
  }
  h2 {
    font:
      400 26px Georgia,
      serif;
    margin: 0 0 12px;
  }
  h2 a {
    text-decoration: none;
  }
  .caption p {
    font-size: 14px;
    line-height: 1.6;
    max-width: 390px;
    margin: 0 0 12px;
    color: #555;
  }
  small {
    color: #777;
    font-size: 11px;
  }
  footer {
    border-top: 1px solid #d6d5d0;
    margin-top: 65px;
    padding-top: 24px;
    font-size: 12px;
    line-height: 1.6;
    color: #666;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .preview {
      height: 280px;
    }
    header span {
      display: none;
    }
  }
  @media (max-width: 420px) {
    iframe {
      width: 312.5%;
      transform: scale(0.32);
    }
    .preview {
      height: 245px;
    }
    .preview-link {
      padding: 16px;
    }
  }
</style>
